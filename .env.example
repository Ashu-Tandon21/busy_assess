SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave unset for local dev — falls back to a SQLite file in the project root.
# In production, point this at Supabase (or any managed Postgres):
#   DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

# Only read when DEBUG=False. Defaults to True; set to False if your host
# already terminates TLS and redirecting again would loop.
SECURE_SSL_REDIRECT=True
